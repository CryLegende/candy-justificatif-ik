# Copier en .env et adapter. Toutes les variables sont facultatives.

# Port d'ecoute du serveur.
IK_PORT=3200

# Dossier des donnees : registre, fiches vehicules, cartes grises, justificatifs.
IK_DOSSIER_DONNEES=./donnees

# Raison sociale imprimee en tete des justificatifs et du recapitulatif.
IK_ENTREPRISE=

# Si renseigne, toutes les routes de l'API exigent ce jeton
# (en-tete x-ik-jeton, ou parametre ?jeton= pour les telechargements).
IK_JETON=

# Instances des services externes. Vides = instances publiques par defaut.
IK_BAN_URL=
IK_OSRM_URL=
IK_TUILES_URL=
